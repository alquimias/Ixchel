    "react-dom": "^19.2.7",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"

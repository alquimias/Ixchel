    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.0",
    "react-hook-form": "^7.80.0",
    "recharts": "3.9.2",
    "shadcn": "^4.12.0",
